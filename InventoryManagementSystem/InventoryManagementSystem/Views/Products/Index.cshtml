@model IEnumerable<InventoryManagementSystem.Models.Product>

@{
    ViewData["Title"] = "Products Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold text-dark"><i class="fa-solid fa-box text-primary me-2"></i>Products</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Add New Product</a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by product name or SKU..." />
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>SKU</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Purchase Price</th>
                        <th>Selling Price</th>
                        <th>Stock</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        var isLowStock = item.StockQuantity <= item.ReorderLevel;
                        <tr>
                            <td><code>@item.SKU</code></td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@(item.Category?.Name ?? "N/A")</td>
                            <td>$@item.PurchasePrice.ToString("N2")</td>
                            <td>$@item.SellingPrice.ToString("N2")</td>
                            <td>
                                <span class="badge @(isLowStock ? "bg-danger" : "bg-success")">
                                    @item.StockQuantity
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Details"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>