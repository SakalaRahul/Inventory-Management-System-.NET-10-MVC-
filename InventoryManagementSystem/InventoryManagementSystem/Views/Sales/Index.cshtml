@model IEnumerable<InventoryManagementSystem.Models.Sale>

@{
    ViewData["Title"] = "Sales History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold text-dark"><i class="fa-solid fa-cash-register text-success me-2"></i>Sales Orders</h1>
    <a asp-action="Create" class="btn btn-success"><i class="fa-solid fa-plus me-1"></i> New Sale</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sale ID</th>
                        <th>Customer</th>
                        <th>Items Count</th>
                        <th>Total Amount</th>
                        <th>Date</th>
                        <th>Processed By</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-semibold">#@item.Id</td>
                            <td>@item.CustomerName</td>
                            <td>@(item.SaleItems?.Sum(si => si.Quantity) ?? 0)</td>
                            <td class="text-success fw-bold">$@item.TotalAmount.ToString("N2")</td>
                            <td>@item.SaleDate.ToLocalTime().ToString("g")</td>
                            <td>@(item.User?.Email ?? "System")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="fa-solid fa-eye"></i> Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>